GRPC_HOST=0.0.0.0
GRPC_PORT=50051
HTTP_HOST=0.0.0.0
HTTP_PORT=8081

DATABASE_URL=postgresql://auth_service:change-me@postgres-host:5432/auth_db
DATABASE_MAX_CONNECTIONS=5
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_ACQUIRE_TIMEOUT_SECONDS=5

INTERNAL_GRPC_TOKEN=change-me-at-least-32-characters
AUTH_JWT_KEY_ID=auth-v1
# Use base64-encoded Ed25519 PEM values in Coolify secrets.
AUTH_JWT_PRIVATE_KEY_B64=base64-private-pem
AUTH_JWT_PUBLIC_KEY_B64=base64-public-pem
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=public-api
AUTH_LOG_SENSITIVE_TOKENS=false

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
EMAIL_CHANGE_TTL_SECONDS=86400
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_DURATION_SECONDS=900
RUST_LOG=info
